# Supabase — create a project at https://supabase.com and copy these from
# Project Settings -> API. The anon key is safe to expose to the client;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — https://account.mapbox.com/access-tokens/
# Public token for maps and Search; secret token is not needed for R1.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Base URL used to build invite links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret required by the scheduled purge route (FR-19). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
