# Supabase — create a project at https://supabase.com and copy these from
# Project Settings -> API. The anon key is safe to expose to the client;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — https://account.mapbox.com/access-tokens/
# Public token for maps and Search; secret token is not needed for R1.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Base URL used to build invite links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret required by the scheduled purge route (FR-19). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Mobile only. The native Mapbox SDK is fetched at build time from Mapbox's
# private Maven and CocoaPods repositories, which needs a *download* token
# (starts with sk.) that is separate from the public access token the app runs
# with. Without it a native build fails at dependency resolution.
#   https://console.mapbox.com/account/access-tokens/
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
EXPO_PUBLIC_MAPBOX_TOKEN=

# --- Push notifications (FR-18) -----------------------------------------------
# Without any of these, push is a no-op: everything else still works, and the
# app simply never buzzes anyone.

# Native, via Expo Push. An access token is only needed for enhanced security
# mode; set PUSH_ENABLED=true to use Expo Push without one.
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=

# Web Push. Generate a key pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL identifying you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
