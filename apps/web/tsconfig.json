{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    // Apps emit nothing, so they need no declarations. Leaving this on
    // makes every exported component type have to be nameable, which two
    // @types/react versions in one workspace make impossible.
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "incremental": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
