{
  "name": "where-are-they",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check": "pnpm typecheck && pnpm test",
    "db:test": "bash scripts/with-postgres.sh bash -c 'for m in supabase/migrations/*.sql; do psql \"$DATABASE_URL\" -q -v ON_ERROR_STOP=1 -f \"$m\"; done; psql \"$DATABASE_URL\" -q -v ON_ERROR_STOP=1 -f supabase/tests/schema_test.sql'",
    "verify": "bash scripts/with-postgres.sh bash scripts/verify.sh",
    "smoke": "bash scripts/with-postgres.sh bash scripts/smoke.sh",
    "migrate": "node scripts/migrate.mjs",
    "migrate:dry": "node scripts/migrate.mjs --dry-run",
    "preflight": "node scripts/preflight.mjs",
    "a11y": "node scripts/a11y.mjs",
    "pwa:check": "node scripts/pwa-check.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2"
  }
}
